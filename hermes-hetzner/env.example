# Hermes Agent — example environment
# Real file lives at: /home/hermes/.hermes/.env  (chmod 600, owned by hermes)
#
# You normally DON'T edit this by hand — the interactive wizards write it for you:
#   hermes setup            # model provider + API key
#   hermes gateway setup    # Slack tokens + allowed users
# This file documents the keys those wizards manage, so you know what's in there.

# --- LLM provider: Claude (Anthropic) ---
# Get a key at https://console.anthropic.com → Settings → API Keys.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# `hermes model` lets you pick the exact Claude model (e.g. a Claude Opus/Sonnet id).

# --- Slack gateway ---
# Bot token (starts xoxb-). One or more, comma-separated.
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# App-level token for Socket Mode (starts xapp-, needs connections:write scope).
SLACK_APP_TOKEN=xapp-your-app-token-here
# SECURITY: required. Without it Hermes denies ALL messages. Comma-separated
# Slack member IDs (look like U01ABC2DEF3) of people allowed to talk to the bot.
SLACK_ALLOWED_USERS=U01ABC2DEF3

# --- Optional: OpenAI-compatible API server (off by default) ---
# API_SERVER_ENABLED=true
# Default port is 8642 — keep it firewalled off from the public internet.
